# CIELVO Environment Configuration Template (Placeholders only)
DATABASE_URL="mysql://cielvo_user:your_password@localhost:3306/cielvo?connection_limit=10"
JWT_SECRET="generate-a-strong-32-character-secret"
SESSION_EXPIRY_DAYS="7"
NEXT_PUBLIC_APP_URL="https://cielvo.com"

# OTP Configuration
OTP_DEV_MODE="false"
OTP_EXPIRY_MINUTES="5"
OTP_MAX_ATTEMPTS="5"

# SMS Gateway (MSG91 / Indian DLT registered)
MSG91_AUTH_KEY="your_msg91_auth_key"
MSG91_SENDER_ID="CIELVO"
MSG91_OTP_TEMPLATE_ID="your_dlt_template_id"

# Email Delivery
RESEND_API_KEY="your_resend_api_key"
EMAIL_FROM="CIELVO <noreply@cielvo.com>"

# Google Maps Platform
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your_google_maps_browser_key"

# Storage
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_key"
CLOUDINARY_API_SECRET="your_cloudinary_secret"
