// CIELVO BeautyTech Marketplace - Production MySQL 8 Schema
// Configured specifically for MySQL 8 with native types, indexes, and constraints

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

model User {
  id               String    @id @default(uuid()) @db.VarChar(36)
  email            String    @unique @db.VarChar(191)
  phone            String    @unique @db.VarChar(20)
  passwordHash     String    @db.VarChar(255)
  role             String    @default("CUSTOMER") @db.VarChar(30)
  status           String    @default("ACTIVE") @db.VarChar(30)
  emailVerified    Boolean   @default(false)
  phoneVerified    Boolean   @default(false)
  createdAt        DateTime  @default(now()) @db.DateTime(6)
  updatedAt        DateTime  @updatedAt @db.DateTime(6)

  customerProfile  CustomerProfile?
  ownedSalons      Salon[]          @relation("SalonOwner")
  staffProfile     SalonStaff?      @relation("StaffUser")
  sessions         Session[]
  notifications    Notification[]
  auditLogs        AdminAuditLog[]
  supportTickets   SupportTicket[]
  assignedTickets  SupportTicket[]  @relation("AssignedAdmin")
  ticketMessages   SupportMessage[]

  @@index([role, status])
  @@map("users")
}

model Session {
  id         String   @id @default(uuid()) @db.VarChar(36)
  userId     String   @db.VarChar(36)
  token      String   @unique @db.VarChar(191)
  expiresAt  DateTime @db.DateTime(6)
  userAgent  String?  @db.VarChar(255)
  ipAddress  String?  @db.VarChar(45)
  createdAt  DateTime @default(now()) @db.DateTime(6)

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationCode {
  id         String   @id @default(uuid()) @db.VarChar(36)
  target     String   @db.VarChar(191)
  type       String   @db.VarChar(50)
  codeHash   String   @db.VarChar(255)
  expiresAt  DateTime @db.DateTime(6)
  verifiedAt DateTime? @db.DateTime(6)
  attempts   Int      @default(0)
  createdAt  DateTime @default(now()) @db.DateTime(6)

  @@index([target, type])
  @@map("verification_codes")
}

model CustomerProfile {
  id             String            @id @default(uuid()) @db.VarChar(36)
  userId         String            @unique @db.VarChar(36)
  fullName       String            @db.VarChar(120)
  avatarUrl      String?           @db.Text
  defaultState   String?           @db.VarChar(100)
  defaultCity    String?           @db.VarChar(100)
  defaultPincode String?           @db.VarChar(10)
  createdAt      DateTime          @default(now()) @db.DateTime(6)
  updatedAt      DateTime          @updatedAt @db.DateTime(6)

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses      CustomerAddress[]
  favourites     CustomerFavourite[]
  bookings       Booking[]
  reviews        Review[]

  @@map("customer_profiles")
}

model CustomerAddress {
  id             String    @id @default(uuid()) @db.VarChar(36)
  customerId     String    @db.VarChar(36)
  label          String    @default("Home") @db.VarChar(50)
  addressLine1   String    @db.VarChar(255)
  addressLine2   String?   @db.VarChar(255)
  landmark       String?   @db.VarChar(150)
  locality       String    @db.VarChar(120)
  city           String    @db.VarChar(100)
  state          String    @db.VarChar(100)
  postalCode     String    @db.VarChar(10)
  latitude       Float?
  longitude      Float?
  isDefault      Boolean   @default(false)
  createdAt      DateTime  @default(now()) @db.DateTime(6)
  updatedAt      DateTime  @updatedAt @db.DateTime(6)

  customer       CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([postalCode])
  @@map("customer_addresses")
}

model CustomerFavourite {
  id         String   @id @default(uuid()) @db.VarChar(36)
  customerId String   @db.VarChar(36)
  salonId    String   @db.VarChar(36)
  createdAt  DateTime @default(now()) @db.DateTime(6)

  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  salon      Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@unique([customerId, salonId])
  @@map("customer_favourites")
}

model Country {
  id        String   @id @default(uuid()) @db.VarChar(36)
  code      String   @unique @db.VarChar(5)
  name      String   @default("India") @db.VarChar(100)
  phoneCode String   @default("+91") @db.VarChar(10)
  states    State[]

  @@map("countries")
}

model State {
  id               String       @id @default(uuid()) @db.VarChar(36)
  countryId        String       @db.VarChar(36)
  name             String       @unique @db.VarChar(100)
  code             String       @unique @db.VarChar(10)
  isUnionTerritory Boolean      @default(false)
  isActive         Boolean      @default(true)

  country          Country      @relation(fields: [countryId], references: [id])
  districts        District[]
  cities           City[]
  postalCodes      PostalCode[]

  @@map("states")
}

model District {
  id        String   @id @default(uuid()) @db.VarChar(36)
  stateId   String   @db.VarChar(36)
  name      String   @db.VarChar(120)
  code      String?  @db.VarChar(10)
  isActive  Boolean  @default(true)

  state     State    @relation(fields: [stateId], references: [id], onDelete: Cascade)
  cities    City[]

  @@unique([stateId, name])
  @@map("districts")
}

model City {
  id          String       @id @default(uuid()) @db.VarChar(36)
  districtId  String?      @db.VarChar(36)
  stateId     String       @db.VarChar(36)
  name        String       @db.VarChar(120)
  tier        Int          @default(1)
  latitude    Float?
  longitude   Float?
  isActive    Boolean      @default(true)

  state       State        @relation(fields: [stateId], references: [id])
  district    District?    @relation(fields: [districtId], references: [id])
  localities  Locality[]
  postalCodes PostalCode[]
  locations   SalonLocation[]

  @@unique([stateId, name])
  @@index([name])
  @@map("cities")
}

model Locality {
  id         String   @id @default(uuid()) @db.VarChar(36)
  cityId     String   @db.VarChar(36)
  name       String   @db.VarChar(150)
  postalCode String?  @db.VarChar(10)
  latitude   Float?
  longitude  Float?
  isActive   Boolean  @default(true)

  city       City     @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([cityId, name])
  @@index([postalCode])
  @@map("localities")
}

model PostalCode {
  id           String   @id @default(uuid()) @db.VarChar(36)
  code         String   @db.VarChar(10)
  cityId       String   @db.VarChar(36)
  stateId      String   @db.VarChar(36)
  localityName String?  @db.VarChar(150)
  latitude     Float?
  longitude    Float?
  isActive     Boolean  @default(true)

  city         City     @relation(fields: [cityId], references: [id])
  state        State    @relation(fields: [stateId], references: [id])

  @@unique([code, localityName])
  @@index([code])
  @@map("postal_codes")
}

model LocationInterest {
  id        String   @id @default(uuid()) @db.VarChar(36)
  state     String   @db.VarChar(100)
  city      String   @db.VarChar(100)
  pincode   String?  @db.VarChar(10)
  email     String?  @db.VarChar(191)
  phone     String?  @db.VarChar(20)
  createdAt DateTime @default(now()) @db.DateTime(6)

  @@map("location_interests")
}

model Salon {
  id                 String          @id @default(uuid()) @db.VarChar(36)
  ownerId            String          @db.VarChar(36)
  businessName       String          @db.VarChar(180)
  slug               String          @unique @db.VarChar(191)
  registrationNumber String?         @db.VarChar(80)
  description        String          @db.Text
  logoUrl            String?         @db.Text
  coverImageUrl      String?         @db.Text
  status             String          @default("PENDING_APPROVAL") @db.VarChar(30)
  approvedAt         DateTime?       @db.DateTime(6)
  rejectionReason    String?         @db.Text
  rating             Float           @default(5.0)
  reviewCount        Int             @default(0)
  allowInSalon       Boolean         @default(true)
  allowAtHome        Boolean         @default(false)
  isFeatured         Boolean         @default(false)
  createdAt          DateTime        @default(now()) @db.DateTime(6)
  updatedAt          DateTime        @updatedAt @db.DateTime(6)

  owner              User            @relation("SalonOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  locations          SalonLocation[]
  documents          SalonDocument[]
  salonServices      SalonService[]
  bookings           Booking[]
  favourites         CustomerFavourite[]
  reviews            Review[]
  paymentRecords     PaymentRecord[]

  @@index([status, isFeatured])
  @@map("salons")
}

model SalonLocation {
  id               String              @id @default(uuid()) @db.VarChar(36)
  salonId          String              @db.VarChar(36)
  branchName       String              @db.VarChar(120)
  phone            String              @db.VarChar(20)
  email            String?             @db.VarChar(191)
  addressLine      String              @db.VarChar(255)
  locality         String              @db.VarChar(150)
  cityId           String?             @db.VarChar(36)
  city             String              @db.VarChar(100)
  district         String?             @db.VarChar(100)
  state            String              @db.VarChar(100)
  postalCode       String              @db.VarChar(10)
  latitude         Float
  longitude        Float
  serviceRadiusKm  Float               @default(10.0)
  allowAtHome      Boolean             @default(false)
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now()) @db.DateTime(6)
  updatedAt        DateTime            @updatedAt @db.DateTime(6)

  salon            Salon               @relation(fields: [salonId], references: [id], onDelete: Cascade)
  cityRef          City?               @relation(fields: [cityId], references: [id])
  hours            SalonHours[]
  staff            SalonStaff[]
  salonServices    SalonService[]
  serviceAreas     SalonServiceArea[]
  bookings         Booking[]
  paymentRecords   PaymentRecord[]
  reviews          Review[]

  @@index([city, state])
  @@index([postalCode])
  @@index([latitude, longitude])
  @@map("salon_locations")
}

model SalonHours {
  id          String        @id @default(uuid()) @db.VarChar(36)
  locationId  String        @db.VarChar(36)
  dayOfWeek   Int
  openTime    String        @default("09:00") @db.VarChar(10)
  closeTime   String        @default("21:00") @db.VarChar(10)
  isClosed    Boolean       @default(false)

  location    SalonLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, dayOfWeek])
  @@map("salon_hours")
}

model SalonDocument {
  id              String    @id @default(uuid()) @db.VarChar(36)
  salonId         String    @db.VarChar(36)
  documentType    String    @db.VarChar(50)
  documentUrl     String    @db.Text
  status          String    @default("PENDING") @db.VarChar(30)
  rejectionReason String?   @db.Text
  uploadedAt      DateTime  @default(now()) @db.DateTime(6)
  verifiedAt      DateTime? @db.DateTime(6)

  salon           Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId, status])
  @@map("salon_documents")
}

model SalonStaff {
  id             String          @id @default(uuid()) @db.VarChar(36)
  locationId     String          @db.VarChar(36)
  userId         String?         @unique @db.VarChar(36)
  fullName       String          @db.VarChar(120)
  phone          String          @db.VarChar(20)
  email          String?         @db.VarChar(191)
  roleTitle      String          @default("Beauty Professional") @db.VarChar(80)
  avatarUrl      String?         @db.Text
  bio            String?         @db.Text
  isActive       Boolean         @default(true)
  isAvailable    Boolean         @default(true)
  atHomeEnabled  Boolean         @default(true)
  createdAt      DateTime        @default(now()) @db.DateTime(6)
  updatedAt      DateTime        @updatedAt @db.DateTime(6)

  location       SalonLocation   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  user           User?           @relation("StaffUser", fields: [userId], references: [id])
  assignedBookings Booking[]
  staffServices  StaffService[]
  availability   StaffAvailability[]
  otpChallenges  BookingOtpChallenge[]

  @@index([locationId, isActive])
  @@map("salon_staff")
}

model StaffService {
  id             String       @id @default(uuid()) @db.VarChar(36)
  staffId        String       @db.VarChar(36)
  salonServiceId String       @db.VarChar(36)

  staff          SalonStaff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  salonService   SalonService @relation(fields: [salonServiceId], references: [id], onDelete: Cascade)

  @@unique([staffId, salonServiceId])
  @@map("staff_services")
}

model StaffAvailability {
  id        String     @id @default(uuid()) @db.VarChar(36)
  staffId   String     @db.VarChar(36)
  date      String     @db.VarChar(20)
  startTime String     @db.VarChar(10)
  endTime   String     @db.VarChar(10)
  isBlocked Boolean    @default(true)
  reason    String?    @db.VarChar(255)

  staff     SalonStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, date])
  @@map("staff_availability")
}

model SalonServiceArea {
  id           String        @id @default(uuid()) @db.VarChar(36)
  locationId   String        @db.VarChar(36)
  postalCode   String        @db.VarChar(10)
  localityName String?       @db.VarChar(150)
  maxDistanceKm Float        @default(10.0)
  isActive     Boolean       @default(true)

  location     SalonLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, postalCode])
  @@map("salon_service_areas")
}

model ServiceCategory {
  id          String    @id @default(uuid()) @db.VarChar(36)
  name        String    @unique @db.VarChar(100)
  slug        String    @unique @db.VarChar(120)
  description String?   @db.Text
  imageUrl    String?   @db.Text
  iconName    String?   @db.VarChar(50)
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.DateTime(6)

  services    Service[]

  @@map("service_categories")
}

model Service {
  id              String          @id @default(uuid()) @db.VarChar(36)
  categoryId      String          @db.VarChar(36)
  name            String          @db.VarChar(150)
  slug            String          @unique @db.VarChar(180)
  description     String          @db.Text
  genderTarget    String          @default("UNISEX") @db.VarChar(20)
  durationMinutes Int             @default(45)
  basePrice       Float           @default(499.0)
  allowAtHome     Boolean         @default(true)
  allowInSalon    Boolean         @default(true)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now()) @db.DateTime(6)

  category        ServiceCategory @relation(fields: [categoryId], references: [id])
  salonServices   SalonService[]

  @@index([categoryId, isActive])
  @@map("services")
}

model SalonService {
  id                    String         @id @default(uuid()) @db.VarChar(36)
  salonId               String         @db.VarChar(36)
  locationId            String         @db.VarChar(36)
  serviceId             String         @db.VarChar(36)
  customPrice           Float
  customDurationMinutes Int
  allowAtHome           Boolean        @default(true)
  allowInSalon          Boolean        @default(true)
  isActive              Boolean        @default(true)
  createdAt             DateTime       @default(now()) @db.DateTime(6)

  salon                 Salon          @relation(fields: [salonId], references: [id], onDelete: Cascade)
  location              SalonLocation  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  service               Service        @relation(fields: [serviceId], references: [id])
  staffServices         StaffService[]
  bookings              Booking[]
  images                ServiceImage[]

  @@unique([locationId, serviceId])
  @@index([salonId, isActive])
  @@map("salon_services")
}

model ServiceImage {
  id             String       @id @default(uuid()) @db.VarChar(36)
  salonServiceId String       @db.VarChar(36)
  imageUrl       String       @db.Text
  sortOrder      Int          @default(0)

  salonService   SalonService @relation(fields: [salonServiceId], references: [id], onDelete: Cascade)

  @@map("service_images")
}

model Booking {
  id                     String                 @id @default(uuid()) @db.VarChar(36)
  bookingNumber          String                 @unique @db.VarChar(50)
  customerId             String                 @db.VarChar(36)
  salonId                String                 @db.VarChar(36)
  locationId             String                 @db.VarChar(36)
  salonServiceId         String                 @db.VarChar(36)
  staffId                String?                @db.VarChar(36)
  bookingType            String                 @default("IN_SALON") @db.VarChar(20)
  status                 String                 @default("REQUESTED") @db.VarChar(40)
  appointmentDate        String                 @db.VarChar(20)
  appointmentTime        String                 @db.VarChar(10)
  serviceDurationMinutes Int
  servicePrice           Float
  totalAmount            Float
  customerNotes          String?                @db.Text

  customerAddressId      String?                @db.VarChar(36)
  serviceAddressSnapshot String?                @db.Text
  customerLatitude       Float?
  customerLongitude      Float?

  cancellationReason     String?                @db.Text
  cancelledBy            String?                @db.VarChar(30)

  acceptedAt             DateTime?              @db.DateTime(6)
  arrivedAt              DateTime?              @db.DateTime(6)
  verifiedAt             DateTime?              @db.DateTime(6)
  startedAt              DateTime?              @db.DateTime(6)
  completedAt            DateTime?              @db.DateTime(6)
  createdAt              DateTime               @default(now()) @db.DateTime(6)
  updatedAt              DateTime               @updatedAt @db.DateTime(6)

  customer               CustomerProfile        @relation(fields: [customerId], references: [id])
  salon                  Salon                  @relation(fields: [salonId], references: [id])
  location               SalonLocation          @relation(fields: [locationId], references: [id])
  salonService           SalonService           @relation(fields: [salonServiceId], references: [id])
  assignedStaff          SalonStaff?            @relation(fields: [staffId], references: [id])
  items                  BookingItem[]
  statusHistory          BookingStatusHistory[]
  otpChallenges          BookingOtpChallenge[]
  paymentRecord          PaymentRecord?
  review                 Review?

  @@index([customerId, status])
  @@index([salonId, status])
  @@index([staffId, appointmentDate])
  @@map("bookings")
}

model BookingItem {
  id              String   @id @default(uuid()) @db.VarChar(36)
  bookingId       String   @db.VarChar(36)
  serviceName     String   @db.VarChar(150)
  categoryName    String   @db.VarChar(100)
  price           Float
  durationMinutes Int

  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_items")
}

model BookingStatusHistory {
  id              String   @id @default(uuid()) @db.VarChar(36)
  bookingId       String   @db.VarChar(36)
  fromStatus      String?  @db.VarChar(40)
  toStatus        String   @db.VarChar(40)
  changedByUserId String?  @db.VarChar(36)
  notes           String?  @db.Text
  createdAt       DateTime @default(now()) @db.DateTime(6)

  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_status_history")
}

model BookingOtpChallenge {
  id                       String               @id @default(uuid()) @db.VarChar(36)
  bookingId                String               @unique @db.VarChar(36)
  staffId                  String               @db.VarChar(36)
  customerId               String               @db.VarChar(36)
  customerOtpHashed        String               @db.VarChar(255)
  professionalOtpHashed    String               @db.VarChar(255)
  customerOtpVerified      Boolean              @default(false)
  professionalOtpVerified  Boolean              @default(false)
  failedAttemptsCustomer   Int                  @default(0)
  failedAttemptsProfessional Int                @default(0)
  isLocked                 Boolean              @default(false)
  expiresAt                DateTime             @db.DateTime(6)
  verifiedAt               DateTime?            @db.DateTime(6)
  createdAt                DateTime             @default(now()) @db.DateTime(6)

  booking                  Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  staff                    SalonStaff           @relation(fields: [staffId], references: [id])
  attemptLogs              OtpAttemptLog[]

  @@map("booking_otp_challenges")
}

model OtpAttemptLog {
  id                 String              @id @default(uuid()) @db.VarChar(36)
  challengeId        String              @db.VarChar(36)
  attemptType        String              @db.VarChar(30)
  submittedByUserId  String              @db.VarChar(36)
  isSuccessful       Boolean
  failureReason      String?             @db.VarChar(255)
  ipAddress          String?             @db.VarChar(45)
  userAgent          String?             @db.VarChar(255)
  attemptedAt        DateTime            @default(now()) @db.DateTime(6)

  challenge          BookingOtpChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
  @@map("otp_attempt_logs")
}

model PaymentRecord {
  id                   String        @id @default(uuid()) @db.VarChar(36)
  bookingId            String        @unique @db.VarChar(36)
  salonId              String        @db.VarChar(36)
  locationId           String        @db.VarChar(36)
  customerId           String        @db.VarChar(36)
  amount               Float
  paymentMethod        String        @default("CASH") @db.VarChar(30)
  paymentStatus        String        @default("NOT_PAID") @db.VarChar(30)
  transactionReference String?       @db.VarChar(120)
  notes                String?       @db.Text
  recordedByUserId     String?       @db.VarChar(36)
  acknowledgedAt       DateTime?     @db.DateTime(6)
  disputeReason        String?       @db.Text
  createdAt            DateTime      @default(now()) @db.DateTime(6)
  updatedAt            DateTime      @updatedAt @db.DateTime(6)

  booking              Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  salon                Salon         @relation(fields: [salonId], references: [id])
  location             SalonLocation @relation(fields: [locationId], references: [id])

  @@index([salonId, paymentStatus])
  @@map("payment_records")
}

model Review {
  id                 String         @id @default(uuid()) @db.VarChar(36)
  bookingId          String         @unique @db.VarChar(36)
  customerId         String         @db.VarChar(36)
  salonId            String         @db.VarChar(36)
  locationId         String         @db.VarChar(36)
  rating             Int
  title              String?        @db.VarChar(150)
  comment            String         @db.Text
  isVerifiedBooking  Boolean        @default(true)
  moderationStatus   String         @default("APPROVED") @db.VarChar(30)
  rejectionReason    String?        @db.Text
  createdAt          DateTime       @default(now()) @db.DateTime(6)
  updatedAt          DateTime       @updatedAt @db.DateTime(6)

  booking            Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer           CustomerProfile @relation(fields: [customerId], references: [id])
  salon              Salon          @relation(fields: [salonId], references: [id])
  location           SalonLocation  @relation(fields: [locationId], references: [id])
  response           ReviewResponse?

  @@index([salonId, moderationStatus])
  @@map("reviews")
}

model ReviewResponse {
  id           String   @id @default(uuid()) @db.VarChar(36)
  reviewId     String   @unique @db.VarChar(36)
  salonId      String   @db.VarChar(36)
  responseText String   @db.Text
  createdAt    DateTime @default(now()) @db.DateTime(6)

  review       Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_responses")
}

model Notification {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @db.VarChar(36)
  title     String   @db.VarChar(180)
  message   String   @db.Text
  type      String   @default("SYSTEM") @db.VarChar(30)
  link      String?  @db.VarChar(255)
  isRead    Boolean  @default(false)
  readAt    DateTime? @db.DateTime(6)
  createdAt DateTime @default(now()) @db.DateTime(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model SupportTicket {
  id              String           @id @default(uuid()) @db.VarChar(36)
  ticketNumber    String           @unique @db.VarChar(50)
  userId          String           @db.VarChar(36)
  bookingId       String?          @db.VarChar(36)
  subject         String           @db.VarChar(200)
  description     String           @db.Text
  priority        String           @default("MEDIUM") @db.VarChar(20)
  status          String           @default("OPEN") @db.VarChar(30)
  assignedAdminId String?          @db.VarChar(36)
  createdAt       DateTime         @default(now()) @db.DateTime(6)
  updatedAt       DateTime         @updatedAt @db.DateTime(6)

  user            User             @relation(fields: [userId], references: [id])
  assignedAdmin   User?            @relation("AssignedAdmin", fields: [assignedAdminId], references: [id])
  messages        SupportMessage[]

  @@index([userId, status])
  @@map("support_tickets")
}

model SupportMessage {
  id        String        @id @default(uuid()) @db.VarChar(36)
  ticketId  String        @db.VarChar(36)
  senderId  String        @db.VarChar(36)
  message   String        @db.Text
  createdAt DateTime      @default(now()) @db.DateTime(6)

  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender    User          @relation(fields: [senderId], references: [id])

  @@map("support_messages")
}

model AdminAuditLog {
  id          String   @id @default(uuid()) @db.VarChar(36)
  adminUserId String   @db.VarChar(36)
  action      String   @db.VarChar(80)
  entityType  String   @db.VarChar(80)
  entityId    String   @db.VarChar(80)
  detailsJson String?  @db.Text
  ipAddress   String?  @db.VarChar(45)
  userAgent   String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @db.DateTime(6)

  adminUser   User     @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId])
  @@index([entityType, entityId])
  @@map("admin_audit_logs")
}

model HomepageBanner {
  id        String   @id @default(uuid()) @db.VarChar(36)
  title     String   @db.VarChar(180)
  subtitle  String?  @db.VarChar(255)
  imageUrl  String   @db.Text
  linkUrl   String?  @db.VarChar(255)
  badgeText String?  @db.VarChar(80)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.DateTime(6)

  @@map("homepage_banners")
}

model PlatformSetting {
  id          String   @id @default(uuid()) @db.VarChar(36)
  key         String   @unique @db.VarChar(100)
  value       String   @db.Text
  description String?  @db.VarChar(255)
  updatedAt   DateTime @updatedAt @db.DateTime(6)

  @@map("platform_settings")
}
